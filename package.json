{
  "name": "money-in-order",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --dir tests",
    "typecheck": "tsc --noEmit",
    "serve": "npm run build && wrangler dev --port 4174",
    "deploy": "npm run typecheck && npm test && npm run build && wrangler deploy",
    "migrate": "node scripts/migrate-from-netlify.mjs"
  },
  "dependencies": {
    "@fontsource-variable/recursive": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4",
    "wrangler": "^4.162.0"
  }
}
