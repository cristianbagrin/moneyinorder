// Money in Order on Cloudflare: one Worker serving the built app (dist/) and the sync API (worker/).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moneyinorder",
  "account_id": "1da66eb742220c8ae068a08cdeeaade3",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the API runs code; every other path is a file from dist/ (or 404, as on Netlify).
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },
  // Encrypted vaults, their change logs and account markers (see worker/bucket.ts).
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "moneyinorder-data" }],
  // Per IP and domain, as on Netlify. namespace_id only has to be unique within the account.
  "ratelimits": [
    { "name": "VAULT_RATE_LIMITER", "namespace_id": "4174001", "simple": { "limit": 120, "period": 60 } },
    { "name": "ACCOUNT_RATE_LIMITER", "namespace_id": "4174002", "simple": { "limit": 30, "period": 60 } }
  ],
  "routes": [{ "pattern": "moneyinorder.cristianbagrin.com", "custom_domain": true }],
  // The app must live at one address only: browser data (and so the budget on a device) belongs to an address.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
